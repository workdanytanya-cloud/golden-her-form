# Локальный/VPS self-hosted контур. Не копируйте production-секреты Supabase.

AUTH_BACKEND=local
DATA_BACKEND=postgres

# Только сервер. Никогда не добавляйте в VITE_*.
DATABASE_URL=postgres://panovapro:panovapro_local@127.0.0.1:54332/panovapro

NODE_ENV=development
# Для http://localhost можно оставить 0. На HTTPS-проде cookie станет Secure автоматически.
SESSION_COOKIE_SECURE=0

# Production-миграции только явно:
# SELFHOST_MIGRATE_CONFIRM=APPLY
