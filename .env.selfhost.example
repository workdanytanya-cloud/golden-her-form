# Локальный/VPS self-hosted контур. Не копируйте production-секреты Supabase.

AUTH_BACKEND=local
DATA_BACKEND=postgres
MEDIA_BACKEND=local-links

# Только сервер. Никогда не добавляйте в VITE_*.
DATABASE_URL=postgres://panovapro:panovapro_local@127.0.0.1:54332/panovapro

NODE_ENV=development
# Для http://localhost можно оставить 0. На HTTPS-проде cookie станет Secure автоматически.
SESSION_COOKIE_SECURE=0

# Публичный URL сайта (без хвоста /) — для ссылок восстановления пароля.
# SELFHOST_PUBLIC_URL=https://example.com

# Почта для selfhost (сброс пароля). Не путать с локальным перехватчиком.
# SELFHOST_MAIL_TRANSPORT=file   # только dev/test → пишет в SELFHOST_MAIL_DIR
# SELFHOST_MAIL_DIR=.selfhost-mail-catcher
# Боевая доставка (один из вариантов, уже используемые в проекте):
# RESEND_API_KEY=...
# SELFHOST_MAIL_FROM=PanovaPRO <noreply@your-domain>
# или: SMTP_ENABLED=1 + SMTP_HOST/USER/PASS

# Production-миграции только явно:
# SELFHOST_MIGRATE_CONFIRM=APPLY
