# Публичные ключи (можно показывать на клиенте — защита идёт через RLS в Supabase)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Те же значения для SSR (серверная часть сайта)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Секретный ключ ТОЛЬКО для сервера (админ-операции). Никогда не публикуйте и не коммитьте.
# Берётся в Supabase → Project Settings → API → service_role / secret
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Уведомления о заявках ---
# Telegram: создайте бота у @BotFather, напишите боту /start, узнайте chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email через Gmail SMTP (рекомендуется для panova.fortuna@gmail.com)
# 1) Google Аккаунт → Безопасность → 2-этапная аутентификация (включить)
# 2) Пароли приложений → создать пароль для «Почта»
# 3) Вставить 16-символьный пароль в SMTP_PASS (без пробелов)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=panova.fortuna@gmail.com
SMTP_PASS=
LEAD_NOTIFY_EMAIL=panova.fortuna@gmail.com
LEAD_NOTIFY_FROM_NAME=PanovaPRO

# Альтернатива: Resend (https://resend.com) — если SMTP не используете
RESEND_API_KEY=
LEAD_NOTIFY_FROM=PanovaPRO <onboarding@resend.dev>
