# Публичные ключи (можно показывать на клиенте — защита идёт через RLS в Supabase)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Те же значения для SSR (серверная часть сайта)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Секретный ключ ТОЛЬКО для сервера (админ-операции). Никогда не публикуйте и не коммитьте.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Уведомления о заявках (рабочая схема для Timeweb / RU VPS) ---
#
# На VPS в РФ часто блокируют api.telegram.org и Gmail SMTP.
# Рабочий канал: HTTPS webhook → Make.com / n8n → Telegram или Email.
#
# 1) Зайти на https://www.make.com (бесплатно)
# 2) Create a new scenario → Webhooks → Custom webhook → Copy address to clipboard
# 3) Добавить модуль Telegram → Send a Text Message / или Email
# 4) В текст подставить {{text}} (или поля full_name, phone, email)
# 5) Включить scenario (ON) и вставить URL ниже:
LEAD_WEBHOOK_URL=

# Прямой Telegram (часто НЕ работает с RU VPS — telegram_network).
# Если нужен прокси Bot API: TELEGRAM_API_BASE=https://ваш-прокси
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=

# Email через Resend HTTP API (порт 443, надёжнее SMTP)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=panova.fortuna@gmail.com
LEAD_NOTIFY_FROM=PanovaPRO <onboarding@resend.dev>

# Gmail SMTP на Timeweb обычно НЕ работает. Включать только если проверили:
# SMTP_ENABLED=1
SMTP_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=panova.fortuna@gmail.com
SMTP_PASS=
LEAD_NOTIFY_FROM_NAME=PanovaPRO

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1

# Админ-кабинет тренера
# Создать/обновить: node --env-file=.env scripts/ensure-admin.mjs
ADMIN_EMAIL=panova.fortuna@gmail.com
# ADMIN_PASSWORD=  # задайте в окружении, не коммитьте в git
